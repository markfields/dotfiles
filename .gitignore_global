!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, …)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
Session.vim
.nvimrc.local

# Emacs
*#
.#*
\#*#
*.elc
auto-save-list
tramp

# Sublime Text
*.sublime-project
*.sublime-workspace


